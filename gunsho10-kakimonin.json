 "poems": [
  {
   "seq": "1",
   "text": "白雪の猶かきくらしふるさとのよしのゝおくも春はきにけり",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "としなみのすゑの松山たちこえて又あら玉の春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ものとにあらたまれとも春をへておなしねにのみ鶯の鳴",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "とふ人のあとこそ見えね庭のおもにつもらてきゆる春の淡雪",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "きえやらぬのはらの雪をふみわけて若菜つみにといつる里人",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春なからふる白雪の下きえに綠をいそくのへのわかくさ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "たつねても我をは誰かとひもこんうへてかひ有やとの梅かえ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "いそのかみふるのゝ草はゆききえてみとり色そふ春雨そふる",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いきうしと思はぬ旅の空なれや人やりならぬ春のかりかね",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "花とみてまつ日かすをやなくさめんさくらにかゝる峯の白雲",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "尋ねつゝわけ入まゝにさく花のにほひも深しみよしのゝおく",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "櫻花さきてとくちるならひこそ我身の春のものおもひなれ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あふさかや嵐の風にちる花をゆくもかへるもおしむ春かな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "嵐ふき花ちるころはよのうきめ見えぬ山ちもかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "さきそめしそなたば風にかつちりて殘るかたえに花そ少なき",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "植置しむかしの人のかたみとて手折櫻はおもかけもなし",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "かたみとてたをる櫻の花たにも散てあとなき色そかなしき",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "こゝのへに色そへて見よむかし思ふみのりの庭の花の一えた",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "なきかけを花によそへて志のへとも是もあたなる色そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "花にたに心はそめし遠さかる春のわかれのうきにつけても",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "おしむにもよらぬ別はうきものと君ゆへ花やおもひふりけん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あかすして別れしまゝにとめをきし心や花をさそひきぬらん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "物おもひなき世の春もをのつから袖にかすめる月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "住の江の松はふりぬる色なれとわかむらさきにさける藤波",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "暮てゆく春のなこりといはねともまかきにきるき山吹の花",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ふく風のめに見ぬ方にさそはれて花とともにや春も行くらん",
   "kana": "",
   "speaker": "の集",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "なれたにも志はしかたらへ時鳥よの人〓ははき身なりとも",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "あし引の山たちはなれほとゝきすをのかさ月はさとなれて鳴",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "いまはまたあやめの草にひきかへてうきねのかゝる椎柴の袖",
   "kana": "",
   "speaker": "そ集",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "思はすよあやめも志らぬ墨染の袖にうきねのかゝるへしとは",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "あまのすむ里のしるへの烟たにたえてほとふる五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "年へぬる宿のふる木のたち花はいくそのかみのかに匂ふらん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "難波かたあしのしのひの數そひてもえつゝとふや螢成らん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "せみのはのたゝひとへなる衣てのもりてすゝしき月の影かな",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "松の風いはもるみつのをとまても秋にすゝめる山かけのいほ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "みそきするなみのゑらゆふ秋かけて川かせすゝしみな月の空",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "から衣たもとすゝしく秋風のたつ日よりこそ露もをきけれ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "なつ衣うすきたもとにふきそめて哀しらする秋の初かせ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "たなはたのくるゝまつまにさきたちて秋風わたる天の川なみ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "このまゝに絕すきかはや雲の上にむかしをのこす峯の松風",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "あはれとも君そきゝけるいまは世にふきたえぬへき峰の松風",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "四のをのしらへにそへし松風はきゝしにもあらぬねにや有劔",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さらにまたなれし其世を忍はれしかきなす〓とのねのみ流れて",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "松にふく風はむかしの秋なからなかはの月やおもかはりせし",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "はかなくて過こし秋や忘られんかきなす琴のねにしたてずは",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "をしなへて秋のゆふへはつゆそをく哀しるへき草葉ならねと",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "風ふけはぬきもとゝめすさゝかにのいと亂れつゝ置ける白露",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "はきか枝にをけらん露のしら玉をはらはてみせ〓のへの秋風",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "のへとをみおはなか末も打なひきのとかにわたる秋の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "なにとかく秋のあはれをしりかほに夕は袖になみたそふらん",
   "kana": "",
   "speaker": "",
   "page": 68,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "おもひやれ同し空にやなかむらんなみたせきあへぬ秋の夕暮",
   "kana": "",
   "speaker": "嘉喜門院御集",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "せきあへぬ淚のほともおもひしれおなしなかめの秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "ときはなる名にはならはて松虫のよな〓〓霜に聲のかれゆく",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "きり〓〓すみなしもかれのあさちふに露の命や消のこるらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "暮てゆく秋やかなしききり〓〓す聲の限りはなきあかしつゝ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "よそにかく淚もよほすつまそともしらてやしかの獨なくらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "つまこふる野へに心のあくかれてをしか鳴なり秋のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "ふる〓の雲井はるかにけさきなきいまた旅なるはつかりの聲",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "いとふへきくまこそなけれすみ渡るはまなの橋の夜はの月影",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "まつらなるたましま川のきよきせに光をそへてみかく月影",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "おもひやる都のそらのおもかけもおなしなかめの秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "すみよしの松のあきかせよさむなる聲うちそへて衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "さと人もくるゝ夜〓とに秋風の身にしむ比ところもうつ也",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "あけわたるをのへの松はあらはれて露にしつめる秋の山もと",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "しら露の色もひとつに咲菊の花はいつよりうつろひぬらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "君かはや秋の宮井にうつるへきほともゝみちの色にこそしれ",
   "kana": "",
   "speaker": "を集",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "ちらて猶秋は千とせにめくるともはこやの山のみねの紅葉は",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "との葉の色をそへすは露時兩そむるもみちもかひやなからん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "ゆく秋や道まとふらん紅葉はのちりかひくもる山のあらしに",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あし引の山かきくもり神無月けふもいくたひ時雨ふるらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "かよひこしあとは木のはにうつもれて嵐にたとる山の下みら",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "なには江や見きはのあしのよもすから結へる霜をはらふ浦風",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "あまつ空雲のみをゆく月かけをこほれる袖にやとしてそみる",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "かたしきの袖にたまらぬ白玉はねやもるよはのあられ成けり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "降りつもるほとも志られて拂はねとをのれとおつる松の白雪",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "かきくらすみねのふら雪それなからともにみし世の佛はなし",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "思へたゝとふにつけても降る雪にみし世を忍ふけさの詠めは",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "おしとおもふとしもはやくゝれ竹の一夜のほとになれる春哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "いかにして心のうちにせきとめんうきなゝろへき袖の涙を",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "かくしつゝうきにたへなて戀しなは後の世迄や苦しからまし",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "うかりける契のほともにしき木のちつかの後そ思ひしりぬる",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "行末を猶やたのまんなみた川なかれて後のあふせありやと",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "おもひかは淚のふらに沈む身はあふせもしらめ物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "僞もさのみはよもとおもふこそ又このくれのたのみなりけれ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "あふまてとおもひし物をあか月の又きぬ〓、にぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "たちかへり袖ぬらせとも契きや我中川のみつの志らなみ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "はかなくそ人の契をたのみける我いつはりもしらぬならひに",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "おり〓〓のつらさを何か歎きけん忘られてたにあられける哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "難波江やあしへをさして行舟のいやとをさかる波のをちかた",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "雲かゝる山の幾重をわけすてゝ宮こをよそにへたてきぬらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "淋しさはまたなれさりしむかしにて松のあらしにすむ心哉",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "山蔭のしはのいほりの淋しさをうき世にかへて誰かすむらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "昨日といひけふと暮してあたし世を只等閑にすくすはかなさ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "おもひやれ見しおもかけもかき暮てなき人こふる袖の涙を",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "かきくらす淚ときくにいとゝ又ほさぬ袂をぬらしそへぬる",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "いまさらにぬれそふ袖の涙哉むかしをかけておもふあはれに",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "夢とたに思ひもはてぬはかなさにさむるうつゝも嘸迷ふらん",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "人しれぬなけきのほとは思しれむかしをかけておつる淚に",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "夢とたにおもひもはてゝ悲しきはさむるうつゝの別なりけり",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "昨日はとひけふはとはるゝあたし世の夢の内なる夢そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "仇し世の習ひはさそとしりなから猶そむかれぬ身を歎きつゝ",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "惠あらは猶行末もおなしくは變らすまもれかすかのゝ神",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "おそらくはかゝるたぐひはすくなくぞ候はんずらむと",
   "kana": "",
   "speaker": "",
   "page": 69,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "今朝よりは春立ぬるや足引の山をしみれは霞たなひく",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "雪きゆるさはへの水のあさ風になひくほとなき春のわか草",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "心をは色にもかにもそめはてつ軒はの梅にありあけの月",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "雲とみえ雪とまかひてよしの山峯にもおにも花は咲けり",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "難波えやあしまの小舟こきかへしくれ行春もしはしとゝまれ",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "谷ふかきしつかいほりのうつき垣花さけはとてとふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "月出ぬ山へかへらてほとゝきすの中の森にしはしかたらへ",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "かつら川うふねのかゝり影見えてたゝ一とをりすくる村雨",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "とへかしの人は音せて下おきのすゑこす風にやとる月影",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "わけ行ははや聲たてゝ夕つく日さすや岡への松むしの鳴",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "月のこる磯山かけに鳴鹿のこゑにはめれぬあまのころもて",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "露ふかみのとなる庭のむら薄人こそわけねあき風そ吹",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "すまのあまのまとをの衣ぬきかへて鹽くまぬよや月に打らん",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "うら遠く鹽引はてゝ見なと江の蘆の枯はにのこる朝霜",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "風さむきまのゝ入江はさよふけてうつらも浪に千とり鳴也",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "すきやらてしはしはこゝになかめてんたかふる里の庭の白雪",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "代々かけて神や守らんわきて我たのむきたのゝ松のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "いつまてといはいき沼の木隱れてよに現れぬみつからそうき",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "身をかくす人もこそあれ雲ふかき山の奥迄たつねてそみん",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "かひなしや人のけはひもたゝそれと聲きくまての中川のやと",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "おり〓〓の〓との葉をたに留めすは何につけてかかこちやらまし",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "さても身のありしにまさる心哉人のつらさは思ひしれとも",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "おほよそはさも社あれと思へかし我身をしらめ恨なりとも",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "かはらしの心ならひにまたるゝよ忘れはてぬと人はおもふに",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "わけすくる山また山のしら雲に猶ふる〓やへたてゆくらん",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "憂なからこゝも旅ねと思はすはしはしもかくて我やすむへき",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "舟とむる磯邊の浪のうつゝにも夢にもうとき都なりけり",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "さらてたに物のさひしき山里の軒はの松にさるさけふなり",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "山深みひとりなかめて淋しきは日もくれ渡るそはのかけはし",
   "kana": "",
   "speaker": "",
   "page": 70,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "をのつから心やすめる山里の岩にこけむす庭のやり水",
   "kana": "",
   "speaker": "",
   "page": 70,
